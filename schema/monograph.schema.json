{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schema/monograph.schema.json",
  "title": "Monograph",
  "description": "One substance page (METHODS.md §8). Sections are fixed; text is built from claims by id. Section 7 is senior-author-only.",
  "type": "object",
  "required": [
    "slug",
    "name",
    "classes",
    "mechanisms",
    "version",
    "status",
    "dates",
    "authors",
    "sections"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "inn": {
      "type": "string",
      "description": "International Nonproprietary Name, where one exists."
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "Depressants",
          "Stimulants",
          "Entactogens",
          "Classic psychedelics",
          "Atypical psychedelics",
          "Dissociatives",
          "Cannabinoids",
          "Opioids",
          "Inhalants",
          "Deliriants"
        ]
      }
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tier": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "metadata-verified",
        "excerpt-verified",
        "appraised",
        "senior-reviewed",
        "published",
        "flagged"
      ]
    },
    "dates": {
      "type": "object",
      "required": [
        "last_search",
        "last_review"
      ],
      "properties": {
        "last_search": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "null until the first systematic search has been run."
        },
        "last_review": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "published": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "coi": {
            "type": "string"
          }
        }
      }
    },
    "at_a_glance": {
      "type": "object",
      "properties": {
        "mechanism_line": {
          "type": "string"
        },
        "legal_summary": {
          "type": "string"
        },
        "best_established": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "description": "Claim ids."
          }
        },
        "largest_uncertainties": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "description": "Claim ids."
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "required": [
          "number",
          "title",
          "claims"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "title": {
            "type": "string"
          },
          "intro": {
            "type": "string",
            "description": "Optional framing prose; must itself contain no uncited empirical claim."
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "no_evidence_note": {
            "type": "string",
            "description": "States what the section does not yet cover and why (not yet searched, or on the reading list but not yet read); shown after the section's claims. When claims is empty it states what the search found."
          },
          "senior_author_only": {
            "type": "boolean",
            "default": false
          },
          "subheadings": {
            "type": "array",
            "description": "Optional sub-headings inside a section, each shown before the claim it names.",
            "items": {
              "type": "object",
              "required": [
                "before",
                "title"
              ],
              "properties": {
                "before": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "priority_questions": {
            "type": "array",
            "description": "Section 15 only: the editors' curated list of questions the page cannot yet answer, each with the study that would answer it. Questions, not findings.",
            "items": {
              "type": "object",
              "required": [
                "question",
                "needs"
              ],
              "properties": {
                "question": {
                  "type": "string"
                },
                "needs": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "not_yet_covered": {
            "type": "string",
            "description": "Section 15 only: topics the monograph does not yet cover."
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "date",
          "change"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "change": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
